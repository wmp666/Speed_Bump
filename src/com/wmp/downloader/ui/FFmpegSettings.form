<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.wmp.downloader.ui.FFmpegSettings">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="526" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="4a0fc" class="javax.swing.JCheckBox" binding="isUseLocalFFmpegCheckBox">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="com/wmp/downloader/laug/special_settings" key="ffmpeg_special_settings.isUseLocal"/>
          <toolTipText resource-bundle="com/wmp/downloader/laug/special_settings" key="ffmpeg_special_settings.isUseLocal.tip"/>
        </properties>
      </component>
      <vspacer id="5d543">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="1" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
      </vspacer>
      <nested-form id="3dfe0" form-file="com/wmp/downloader/ui/common/PathSelectionPanel.form" binding="localFFmpegPathPanel" custom-create="true">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
      </nested-form>
      <component id="2c247" class="javax.swing.JLabel">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <foreground color="-846828"/>
          <text resource-bundle="com/wmp/downloader/laug/special_settings" key="ffmpeg_special_settings.setLocalPath.tip"/>
        </properties>
      </component>
      <component id="98a52" class="javax.swing.JButton" binding="downloadButton">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <text resource-bundle="com/wmp/downloader/laug/common" key="download"/>
        </properties>
      </component>
    </children>
  </grid>
</form>
