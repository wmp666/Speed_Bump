<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.wmp.downloader.ui.task.createTask.LinkFileChoosePanel">
  <grid id="27dc6" binding="mainPanel" layout-manager="GridLayoutManager" row-count="2" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="336" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <scrollpane id="9189b">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="46793" class="javax.swing.JTable" binding="FilesTable" custom-create="true">
            <constraints/>
            <properties/>
          </component>
        </children>
      </scrollpane>
      <grid id="e6994" layout-manager="FlowLayout" hgap="5" vgap="5" flow-align="0">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="b7934" class="javax.swing.JButton" binding="selectionAllbutton">
            <constraints/>
            <properties>
              <label value="全选"/>
              <text resource-bundle="com/wmp/downloader/laug/laug" key="selection_all"/>
            </properties>
          </component>
          <component id="87650" class="javax.swing.JButton" binding="selectionNoneButton">
            <constraints/>
            <properties>
              <label resource-bundle="com/wmp/downloader/laug/laug" key="selection_none"/>
              <text resource-bundle="com/wmp/downloader/laug/laug" key="selection_none"/>
            </properties>
          </component>
          <component id="893d2" class="javax.swing.JButton" binding="selectionReverseButton">
            <constraints/>
            <properties>
              <text resource-bundle="com/wmp/downloader/laug/laug" key="selection_reverse"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
