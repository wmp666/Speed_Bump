#define MyAppName "SpeedBump"
#define MyAppVersion "0.5.6"
#define MyAppPublisher "wmp"
#define MyAppURL "https://github.com/wmp666/Speed_Bump"
#define MyAppExeName "SpeedBump.exe"

[Setup]
; NOTE: The value of AppId uniquely identifies this application. Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppVerName={#MyAppName}
AppId={{D2534130-7E2F-4A26-8B3D-E022FA0EFD2F}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
; "ArchitecturesAllowed=x64compatible" specifies that Setup cannot run
; on anything but x64 and Windows 11 on Arm.
ArchitecturesAllowed=x64compatible
; "ArchitecturesInstallIn64BitMode=x64compatible" requests that the
; install be done in "64-bit mode" on x64 or Windows 11 on Arm,
; meaning it should use the native 64-bit Program Files directory and
; the 64-bit view of the registry.
ArchitecturesInstallIn64BitMode=x64compatible
DefaultGroupName={#MyAppName}
AllowNoIcons=yes
; 协议页展示 helpDocs\鸣谢与声明.md（隐私保护 + 免责声明全文），路径相对脚本所在目录
; 注意：该 .md 请保持 UTF-8 编码（Inno Setup 7 按 UTF-8 读取；更早的 6.x 需要带 BOM，否则向导里的中文会乱码）
LicenseFile={#SourcePath}\helpDocs\鸣谢与声明.md
; 程序属性里也写明不收集数据（显示在「程序和功能」的支持信息中）
AppComments=本软件及其相关拓展不收集任何用户数据；隐私保护与免责声明见安装时的许可协议页。
; Remove the following line to run in administrative install mode (install for all users).
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog
OutputDir=C:\Users\21348\Desktop
OutputBaseFilename=Speed_Bump_Setup_{#MyAppVersion}
SolidCompression=yes
SetupIconFile=C:\Users\21348\Desktop\吴鹤轩\Java\Speed_Bump\install.ico
WizardStyle=modern dynamic windows11

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"
Name: "chinese"; MessagesFile: "compiler:Languages\ChineseSimplified.isl"
Name: "ctchinese"; MessagesFile: "compiler:Languages\CTChinese.isl"

[Messages]
; 欢迎页提示里补一句隐私说明（按语言分别覆盖，保留原有的 [name/ver] 占位符）
english.WelcomeLabel2=This will install [name/ver] on your computer.%n%nThis software and its plugins collect no user data — see the privacy terms on the license page.%n%nIt is recommended that you close all other applications before continuing.
chinese.WelcomeLabel2=即将在您的计算机上安装 [name/ver]。%n%n本软件及其拓展不收集任何用户数据，详见许可协议页的隐私保护条款。%n%n建议您在继续安装前关闭所有其他应用程序。
ctchinese.WelcomeLabel2=即將在您的電腦上安裝 [name/ver]。%n%n本軟體及其拓展不收集任何使用者資料，詳見許可協議頁的隱私保護條款。%n%n建議您在繼續安裝前關閉所有其他應用程式。

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[Files]
Source: "C:\Users\21348\Desktop\安装包\exe\SpeedBump\SpeedBump\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
Source: "C:\Users\21348\Desktop\吴鹤轩\Java\Speed_Bump\out\artifacts\DownLoader_Windows_jar\*"; DestDir: "{app}\app"; Flags: ignoreversion recursesubdirs createallsubdirs
; 更新日志文件（打包进安装程序，但安装时不复制，仅供脚本读取）
Source: "C:\Users\21348\Desktop\吴鹤轩\Java\Speed_Bump\文档\减速带更新.md"; DestDir: "{tmp}"; Flags: dontcopy
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{group}\{cm:ProgramOnTheWeb,{#MyAppName}}"; Filename: "{#MyAppURL}"
Name: "{group}\{cm:UninstallProgram,{#MyAppName}}"; Filename: "{uninstallexe}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent

[Code]
var
  UpdateLogPage: TWizardPage;
  UpdateLogMemo: TNewMemo;

{ 简单去除 Markdown 标记，让纯文本 Memo 显示更干净 }
procedure StripMarkdown(var S: String);
begin
  StringChangeEx(S, '### ', '', True);
  StringChangeEx(S, '## ',  '', True);
  StringChangeEx(S, '**',  '', True);
  StringChangeEx(S, '`',   '', True);
end;

{ 把换行符统一成 Windows 的 CRLF，否则 TNewMemo 不换行 }
procedure NormalizeNewlines(var S: String);
begin
  { 先统一成 LF，避免把已有的 CRLF 变成 CRCRLF }
  StringChangeEx(S, #13#10, #10, True);
  { 再把 LF 变成 CRLF }
  StringChangeEx(S, #10, #13#10, True);
end;

procedure InitializeWizard();
var
  LogContentAnsi: AnsiString;
  LogContent: String;
begin
  { 在欢迎页之后插入「更新日志」页 }
  UpdateLogPage := CreateCustomPage(
    wpWelcome,
    '更新日志',
    '本次更新内容（版本 {#MyAppVersion}）：'
  );

  { 用只读的 TNewMemo 显示日志 }
  UpdateLogMemo := TNewMemo.Create(UpdateLogPage);
  UpdateLogMemo.Parent     := UpdateLogPage.Surface;
  UpdateLogMemo.Left       := 0;
  UpdateLogMemo.Top        := 0;
  UpdateLogMemo.Width      := UpdateLogPage.SurfaceWidth;
  UpdateLogMemo.Height     := UpdateLogPage.SurfaceHeight;
  UpdateLogMemo.ScrollBars := ssVertical;
  UpdateLogMemo.ReadOnly   := True;
  UpdateLogMemo.WordWrap   := True;

  { 从临时目录解压并读取日志文件 }
  ExtractTemporaryFile('减速带更新.md');
  if LoadStringFromFile(ExpandConstant('{tmp}\减速带更新.md'), LogContentAnsi) then
  begin
    LogContent := LogContentAnsi;    { AnsiString 自动转 String }
    NormalizeNewlines(LogContent);   { 先处理换行 }
    StripMarkdown(LogContent);       { 再去 Markdown 标记 }
    UpdateLogMemo.Text := LogContent;
  end
  else
    UpdateLogMemo.Text := '无法加载更新日志。';
end;