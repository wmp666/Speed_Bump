ale);\r\n\r\n                    int x = (panelWidth - scaledWidth) / 2;\r\n                    int y = (panelHeight - scaledHeight) / 2;\r\n\r\n                    g2d.drawImage(backgroundImage, x, y, scaledWidth, scaledHeight, this);\r\n                }\r\n                g2d.dispose();\r\n            }\r\n        }\r\n    }\r\n}
