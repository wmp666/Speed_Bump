<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.wmp.downloader.ui.Downloader">
  <grid id="27dc6" binding="UIPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="639" height="965"/>
    </constraints>
    <properties>
      <opaque value="false"/>
      <preferredSize width="0" height="0"/>
    </properties>
    <border type="none"/>
    <children>
      <tabbedpane id="c729a" binding="mainTabbedPane" custom-create="true">
        <constraints border-constraint="Center"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none">
          <size top="10" left="10" bottom="10" right="10"/>
        </border>
        <children>
          <grid id="f7541" binding="downloaderPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/speed_bump/common/background/resource/laug/laug" title-key="task"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="10" left="10" bottom="10" right="10"/>
            </border>
            <children/>
          </grid>
          <grid id="3f2e6" binding="settingsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/speed_bump/common/background/resource/laug/laug" title-key="settings"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="10" left="10" bottom="10" right="10"/>
            </border>
            <children/>
          </grid>
          <grid id="ab4a3" binding="SpecialSettingsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/speed_bump/common/background/resource/laug/laug" title-key="special_settings"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="5" left="5" bottom="5" right="5"/>
            </border>
            <children/>
          </grid>
          <grid id="ae5b5" binding="pluginParserControlPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/speed_bump/common/background/resource/laug/laug" title-key="plugins"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children/>
          </grid>
          <grid id="f9c8d" binding="aboutPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/speed_bump/common/background/resource/laug/laug" title-key="about"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="10" left="10" bottom="10" right="10"/>
            </border>
            <children/>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>
