<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.wmp.downloader.ui.common.PathSelectionPanel">
  <grid id="27dc6" binding="PathSelectionPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="46"/>
    </constraints>
    <properties>
      <opaque value="false"/>
    </properties>
    <border type="none"/>
    <children>
      <component id="b260f" class="javax.swing.JLabel" binding="DownloadFileLocationLabel">
        <constraints border-constraint="West"/>
        <properties>
          <text resource-bundle="com/wmp/downloader/laug/laug" key="task.create_task.download_settings.download_file_location"/>
        </properties>
      </component>
      <component id="7e55" class="javax.swing.JTextField" binding="FileTextField">
        <constraints border-constraint="Center"/>
        <properties>
          <opaque value="false"/>
        </properties>
      </component>
      <component id="bd780" class="javax.swing.JButton" binding="LocationChooseButton" custom-create="true">
        <constraints border-constraint="East"/>
        <properties>
          <opaque value="false"/>
          <text value=""/>
        </properties>
      </component>
    </children>
  </grid>
</form>
