<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.wmp.downloader.ui.Downloader">
  <grid id="27dc6" binding="UIPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="639" height="965"/>
    </constraints>
    <properties>
      <opaque value="false"/>
      <preferredSize width="0" height="0"/>
    </properties>
    <border type="none"/>
    <children>
      <tabbedpane id="c729a" binding="mainTabbedPane" custom-create="true">
        <constraints border-constraint="Center"/>
        <properties>
          <opaque value="false"/>
        </properties>
        <border type="none">
          <size top="10" left="10" bottom="10" right="10"/>
        </border>
        <children>
          <grid id="f7541" binding="downloaderPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/downloader/laug/laug" title-key="task"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="10" left="10" bottom="10" right="10"/>
            </border>
            <children>
              <grid id="c7014" binding="TaskButtonPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                <margin top="0" left="0" bottom="0" right="0"/>
                <constraints border-constraint="North"/>
                <properties>
                  <opaque value="false"/>
                </properties>
                <border type="empty">
                  <size top="5" left="5" bottom="5" right="5"/>
                </border>
                <children>
                  <component id="ed744" class="javax.swing.JButton" binding="createTaskButton">
                    <constraints>
                      <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <autoscrolls value="false"/>
                      <defaultCapable value="true"/>
                      <doubleBuffered value="false"/>
                      <focusCycleRoot value="false"/>
                      <focusTraversalPolicyProvider value="false"/>
                      <focusable value="true"/>
                      <inheritsPopupMenu value="false"/>
                      <opaque value="false"/>
                      <requestFocusEnabled value="true"/>
                      <rolloverEnabled value="true"/>
                      <selected value="false"/>
                      <text resource-bundle="com/wmp/downloader/laug/laug" key="task.creat_task"/>
                      <toolTipText resource-bundle="com/wmp/downloader/laug/laug" key="task.creat_task.tool_tip_text"/>
                    </properties>
                  </component>
                  <hspacer id="e642">
                    <constraints>
                      <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                    </constraints>
                  </hspacer>
                  <grid id="36129" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints>
                      <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                    </constraints>
                    <properties>
                      <opaque value="false"/>
                    </properties>
                    <border type="none"/>
                    <children>
                      <component id="3392c" class="javax.swing.JButton" binding="allStartButton">
                        <constraints>
                          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <opaque value="false"/>
                          <text resource-bundle="com/wmp/downloader/laug/laug" key="task.taskControl.allStart"/>
                        </properties>
                      </component>
                      <hspacer id="f92a0">
                        <constraints>
                          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="1" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                      </hspacer>
                      <component id="46e65" class="javax.swing.JButton" binding="allPauseButton">
                        <constraints>
                          <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
                        </constraints>
                        <properties>
                          <opaque value="false"/>
                          <text resource-bundle="com/wmp/downloader/laug/laug" key="task.taskControl.allPause"/>
                        </properties>
                      </component>
                    </children>
                  </grid>
                </children>
              </grid>
              <scrollpane id="cede1" binding="TasksScrollPane" custom-create="true">
                <constraints border-constraint="Center"/>
                <properties/>
                <border type="none"/>
                <children>
                  <grid id="a9642" binding="TasksPanel" custom-create="true" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
                    <margin top="0" left="0" bottom="0" right="0"/>
                    <constraints/>
                    <properties>
                      <opaque value="false"/>
                    </properties>
                    <border type="none"/>
                    <children/>
                  </grid>
                </children>
              </scrollpane>
            </children>
          </grid>
          <grid id="3f2e6" binding="settingsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/downloader/laug/laug" title-key="settings"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="10" left="10" bottom="10" right="10"/>
            </border>
            <children/>
          </grid>
          <grid id="ab4a3" binding="SpecialSettingsPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/downloader/laug/laug" title-key="special_settings"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="5" left="5" bottom="5" right="5"/>
            </border>
            <children/>
          </grid>
          <grid id="ae5b5" binding="pluginParserControlPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/downloader/laug/laug" title-key="plugins"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="none"/>
            <children/>
          </grid>
          <grid id="f9c8d" binding="aboutPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
            <constraints>
              <tabbedpane title-resource-bundle="com/wmp/downloader/laug/laug" title-key="about"/>
            </constraints>
            <properties>
              <opaque value="false"/>
            </properties>
            <border type="empty">
              <size top="10" left="10" bottom="10" right="10"/>
            </border>
            <children/>
          </grid>
        </children>
      </tabbedpane>
    </children>
  </grid>
</form>
